# Server & HTTP Settings
REQUEST_TIMEOUT_SECONDS=12.0
MAX_CONCURRENT_REQUESTS=6
MAX_RESULTS_PER_PLATFORM=5
CACHE_TTL_SECONDS=300

# LLM Provider ("openai", "gemini", or "anthropic")
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Authorized Search APIs (use Google Custom Search OR SerpAPI)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=

# Optional Official Platform APIs
YOUTUBE_API_KEY=
REQUESTS_PER_MINUTE=20
